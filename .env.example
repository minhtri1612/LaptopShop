# Server
PORT=3000
NODE_ENV=development

# Required secrets (no hardcoded fallbacks)
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=1d

# Database
DATABASE_URL=mysql://root:password@localhost:3306/nodejspro

# AWS S3 (optional for local without uploads)
# AWS_REGION=ap-southeast-2
# AWS_S3_BUCKET=your-bucket
