# Copy to .env and fill in real values. .env is gitignored.
# Docker Compose reads .env automatically and substitutes ${...} in docker-compose.yml.

# Server
PORT=3000
NODE_ENV=development

# Required secrets
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=1d

# Database
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=nodejspro
# Host app. Compose publishes MySQL on 3307. The container URL is built inside docker-compose.yml.
DATABASE_URL=mysql://root:change-me@127.0.0.1:3307/nodejspro
# Production only. Reads use the replica. Leave unset locally so reads stay on DATABASE_URL.
# DATABASE_REPLICA_URL=

# AWS S3 (optional for local without uploads)
# AWS_REGION=ap-southeast-2
# AWS_S3_BUCKET=your-bucket
